{
  "name": "tech-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/web\" build && pnpm --filter \"./apps/api\" build",
    "lint": "pnpm --parallel --filter \"./apps/*\" lint",
    "typecheck": "pnpm --parallel --filter \"./apps/*\" typecheck"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
